build/
.build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcuserstate
xcuserdata/
.swiftpm/

# xcodegen-generated projects are reproducible from project.yml — not tracked
DKBSecretNative.xcodeproj/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp
